# Environment configuration for AI Study Agent

# Application Settings
PROJECT_NAME="AI Study Agent"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-very-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# LLM Provider Configuration (gemini, groq, openrouter, ollama, openai)
DEFAULT_LLM_PROVIDER="gemini"
DEFAULT_MODEL_NAME="gemini-3.6-flash"

# API Keys
GOOGLE_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Database Configuration (MongoDB Atlas or Local MongoDB)
# For local development without MongoDB server, the app includes an automatic in-memory / mock database fallback
MONGODB_URL=""
MONGODB_DB_NAME="ai_study_agent"

# Vector Store & Storage Settings
CHROMA_PERSIST_DIR="./data/chromadb"
UPLOAD_DIR="./data/uploads"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
MAX_UPLOAD_SIZE_MB=50
